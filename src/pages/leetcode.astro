    class ListNode {
        val: number;
        next: ListNode | null;
        constructor(val?: number, next?: ListNode | null) {
            this.val = val === undefined ? 0 : val;
            this.next = next === undefined ? null : next;
        }
    }
    // list1 1 - 6 - 8
    // list2 1 - 3 - 4
    function printList(node: ListNode | null): void {
        while (node != null) {
            console.log(node.val);
            node = node.next;
        }
    }

    const list1 = new ListNode(1, new ListNode(6, new ListNode(8)));
    const list2 = new ListNode(2, new ListNode(3, new ListNode(4)));оз

    function mergeTwoLists(
        list1: ListNode | null,
        list2: ListNode | null,
    ): ListNode | null {
        let result = new ListNode(-1);

        // printList(list1);
