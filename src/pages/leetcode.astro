        // [2]
        // B-Tree
        // Графы

        while (list1 != null && list2 != null) {
            if (list1.val < list2.val) {
                result.next = new ListNode(list1.val, new ListNode(list2.val));
            } else {
                result.next = new ListNode(list2.val, new ListNode(list1.val));
            }

            list1 = list1.next;
            list2 = list2.next;

            //result = result.next;

            printList(result);
            console.log("---");
