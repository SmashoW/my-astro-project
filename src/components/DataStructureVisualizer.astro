---
// Компонент визуализации структур данных
---

<div class="ds-visualizer">
  <!-- Шляпка компонента с выбором структуры -->
  <div class="header">
    <div class="selector-group">
      <label for="ds-select">Структура данных:</label>
      <select id="ds-select">
        <option value="array">Массив (Array)</option>
        <option value="linkedlist">Связный список (Linked List)</option>
        <option value="set">Множество (Set)</option>
        <option value="map">Хэш-карта / Объект (Map / Object)</option>
      </select>
    </div>

    <!-- Интерактивная панель ввода -->
    <div class="action-panel">
      <div id="key-input-wrapper" class="input-wrapper hidden">
        <input type="text" id="input-key" placeholder="Ключ (Key)" />
      </div>
      <div class="input-wrapper">
        <input
          type="text"
          id="input-val"
          placeholder="Значение (Value)"
          value="42"
        />
      </div>

      <div class="btn-group">
        <button id="btn-add" class="btn btn-primary">Добавить / Set</button>
        <button id="btn-search" class="btn btn-secondary">Найти</button>
        <button id="btn-delete" class="btn btn-danger">Удалить</button>
      </div>
    </div>
  </div>

  <!-- Лог операций с O-нотацией -->
  <div class="log-banner" id="log-banner">
    <span class="log-title">Операция:</span>
    <span class="log-text" id="log-text"
      >Выберите действие для визуализации</span
    >
    <span class="log-badge" id="log-badge">O(1)</span>
  </div>

  <!-- Холст визуализации -->
  <div class="canvas" id="canvas">
    <!-- Элементы генерируются динамически через JS -->
  </div>
</div>

<script>
  // --- Состояние данных ---
  type DSType = "array" | "linkedlist" | "set" | "map";

  let currentDS: DSType = "array";

  // Исходные структуры
  let arrayData: string[] = ["10", "20", "30", "40"];
  let linkedListData: string[] = ["A", "B", "C"];
  let setData: Set<string> = new Set(["Яблоко", "Груша", "Банан"]);
  let mapData: Map<string, string> = new Map([
    ["id", "101"],
    ["name", "Алексей"],
    ["role", "Admin"],
  ]);

  // Элементы DOM
  const dsSelect = document.getElementById("ds-select") as HTMLSelectElement;
  const inputKey = document.getElementById("input-key") as HTMLInputElement;
  const inputVal = document.getElementById("input-val") as HTMLInputElement;
  const keyWrapper = document.getElementById(
    "key-input-wrapper",
  ) as HTMLDivElement;

  const btnAdd = document.getElementById("btn-add") as HTMLButtonElement;
  const btnSearch = document.getElementById("btn-search") as HTMLButtonElement;
  const btnDelete = document.getElementById("btn-delete") as HTMLButtonElement;

  const canvas = document.getElementById("canvas") as HTMLDivElement;
  const logText = document.getElementById("log-text") as HTMLSpanElement;
  const logBadge = document.getElementById("log-badge") as HTMLSpanElement;

  // --- Логирование ---
  function setLog(
    message: string,
    complexity: string,
    type: "info" | "success" | "warn" | "error" = "info",
  ) {
    logText.textContent = message;
    logBadge.textContent = complexity;

    logBadge.className = "log-badge";
    if (type === "success") logBadge.classList.add("badge-success");
    if (type === "error") logBadge.classList.add("badge-error");
    if (type === "warn") logBadge.classList.add("badge-warn");
  }

  // --- Рендеринг Canvas ---
  function render() {
    canvas.innerHTML = "";

    if (currentDS === "array") {
      keyWrapper.classList.add("hidden");
      renderArray();
    } else if (currentDS === "linkedlist") {
      keyWrapper.classList.add("hidden");
      renderLinkedList();
    } else if (currentDS === "set") {
      keyWrapper.classList.add("hidden");
      renderSet();
    } else if (currentDS === "map") {
      keyWrapper.classList.remove("hidden");
      renderMap();
    }
  }

  // 1. Отрисовка Массива
  function renderArray() {
    canvas.className = "canvas flex-row";
    arrayData.forEach((val, idx) => {
      const node = document.createElement("div");
      node.className = "ds-node array-node";
      node.dataset.index = String(idx);
      node.innerHTML = `
        <div class="node-body">${val}</div>
        <div class="node-idx">[${idx}]</div>
      `;
      canvas.appendChild(node);
    });
  }

  // 2. Отрисовка Связного списка
  function renderLinkedList() {
    canvas.className = "canvas flex-row";
    linkedListData.forEach((val, idx) => {
      const node = document.createElement("div");
      node.className = "ds-node ll-node";
      node.dataset.index = String(idx);
      node.innerHTML = `
        <div class="ll-content">
          <span class="val">${val}</span>
          <span class="ptr">next</span>
        </div>
      `;
      canvas.appendChild(node);

      // Стрелка указателя
      if (idx < linkedListData.length - 1) {
        const arrow = document.createElement("div");
        arrow.className = "ll-arrow";
        arrow.textContent = "➔";
        canvas.appendChild(arrow);
      } else {
        const nullPtr = document.createElement("div");
        nullPtr.className = "ll-null";
        nullPtr.textContent = "➔ null";
        canvas.appendChild(nullPtr);
      }
    });
  }

  // 3. Отрисовка Множества (Set)
  function renderSet() {
    canvas.className = "canvas flex-wrap";
    setData.forEach((val) => {
      const bubble = document.createElement("div");
      bubble.className = "ds-node set-bubble";
      bubble.dataset.value = val;
      bubble.textContent = val;
      canvas.appendChild(bubble);
    });
  }

  // 4. Отрисовка Хэш-карты (Map / Object)
  function renderMap() {
    canvas.className = "canvas flex-col";
    mapData.forEach((val, key) => {
      const row = document.createElement("div");
      row.className = "ds-node map-row";
      row.dataset.key = key;
      row.innerHTML = `
        <span class="map-key">"${key}":</span>
        <span class="map-val">"${val}"</span>
      `;
      canvas.appendChild(row);
    });
  }

  // --- Действия (Insert, Search, Delete) ---

  // Вставка
  btnAdd.addEventListener("click", () => {
    const val = inputVal.value.trim();
    const key = inputKey.value.trim();

    if (!val && currentDS !== "map") return;

    if (currentDS === "array") {
      arrayData.push(val);
      render();
      setLog(
        `Добавлен элемент "${val}" в конец массива (push).`,
        "O(1)",
        "success",
      );
    } else if (currentDS === "linkedlist") {
      linkedListData.push(val);
      render();
      setLog(
        `Создан новый узел "${val}" и привязан к хвосту списка.`,
        "O(1)",
        "success",
      );
    } else if (currentDS === "set") {
      if (setData.has(val)) {
        setLog(
          `Значение "${val}" уже есть в Set! Множество хранит только уникальные элементы.`,
          "O(1)",
          "warn",
        );
        highlightSetItem(val, "highlight-warn");
      } else {
        setData.add(val);
        render();
        setLog(
          `Добавлено новое уникальное значение "${val}".`,
          "O(1)",
          "success",
        );
      }
    } else if (currentDS === "map") {
      if (!key) {
        alert("Введите ключ!");
        return;
      }
      mapData.set(key, val);
      render();
      setLog(
        `Записан ключ-значение ["${key}": "${val}"]. Хэш-функция вычислила бакет за O(1).`,
        "O(1)",
        "success",
      );
    }
  });

  // Поиск (с анимацией)
  btnSearch.addEventListener("click", async () => {
    const val = inputVal.value.trim();
    const key = inputKey.value.trim();

    if (currentDS === "array") {
      setLog(`Линейный поиск элемента "${val}"...`, "O(n)");
      const nodes = document.querySelectorAll(".array-node");
      let found = false;

      for (let i = 0; i < arrayData.length; i++) {
        const node = nodes[i] as HTMLElement;
        node.classList.add("highlight-search");
        await new Promise((r) => setTimeout(r, 400));

        if (arrayData[i] === val) {
          node.classList.remove("highlight-search");
          node.classList.add("highlight-found");
          setLog(
            `Элемент "${val}" найден по индексу [${i}]!`,
            "O(n)",
            "success",
          );
          found = true;
          break;
        }
        node.classList.remove("highlight-search");
      }

      if (!found)
        setLog(`Элемент "${val}" не найден в массиве.`, "O(n)", "error");
    } else if (currentDS === "linkedlist") {
      setLog(`Обход списка от head к tail для поиска "${val}"...`, "O(n)");
      const nodes = document.querySelectorAll(".ll-node");
      let found = false;

      for (let i = 0; i < linkedListData.length; i++) {
        const node = nodes[i] as HTMLElement;
        node.classList.add("highlight-search");
        await new Promise((r) => setTimeout(r, 400));

        if (linkedListData[i] === val) {
          node.classList.remove("highlight-search");
          node.classList.add("highlight-found");
          setLog(
            `Узел со значением "${val}" найден за ${i + 1} шаг(ов).`,
            "O(n)",
            "success",
          );
          found = true;
          break;
        }
        node.classList.remove("highlight-search");
      }

      if (!found) setLog(`Узел "${val}" не найден.`, "O(n)", "error");
    } else if (currentDS === "set") {
      setLog(`Мгновенная проверка методом Set.has("${val}")...`, "O(1)");
      if (setData.has(val)) {
        highlightSetItem(val, "highlight-found");
        setLog(
          `Элемент "${val}" найден в Set мгновенно по хэшу!`,
          "O(1)",
          "success",
        );
      } else {
        setLog(`Элемент "${val}" отсутствует в Set.`, "O(1)", "error");
      }
    } else if (currentDS === "map") {
      if (!key) {
        alert("Введите ключ для поиска!");
        return;
      }
      setLog(`Прямой доступ Map.get("${key}")...`, "O(1)");
      if (mapData.has(key)) {
        highlightMapItem(key, "highlight-found");
        setLog(
          `Ключ "${key}" найден! Значение: "${mapData.get(key)}".`,
          "O(1)",
          "success",
        );
      } else {
        setLog(`Ключ "${key}" не найден в Map/Объекте.`, "O(1)", "error");
      }
    }
  });

  // Удаление
  btnDelete.addEventListener("click", () => {
    const val = inputVal.value.trim();
    const key = inputKey.value.trim();

    if (currentDS === "array") {
      const idx = arrayData.indexOf(val);
      if (idx !== -1) {
        arrayData.splice(idx, 1);
        render();
        setLog(
          `Удален элемент "${val}" (потребовался сдвиг всех последующих элементов).`,
          "O(n)",
          "warn",
        );
      } else {
        setLog(`Элемент "${val}" не найден для удаления.`, "O(n)", "error");
      }
    } else if (currentDS === "linkedlist") {
      const idx = linkedListData.indexOf(val);
      if (idx !== -1) {
        linkedListData.splice(idx, 1);
        render();
        setLog(
          `Узел "${val}" удален. Указатели предыдущего и следующего узлов пересвязаны.`,
          "O(1)*",
          "warn",
        );
      } else {
        setLog(`Узел "${val}" не найден.`, "O(n)", "error");
      }
    } else if (currentDS === "set") {
      if (setData.has(val)) {
        setData.delete(val);
        render();
        setLog(
          `Элемент "${val}" удален из Set по хэш-ключу.`,
          "O(1)",
          "success",
        );
      } else {
        setLog(`Элемент "${val}" не найден в Set.`, "O(1)", "error");
      }
    } else if (currentDS === "map") {
      if (!key) {
        alert("Введите ключ для удаления!");
        return;
      }
      if (mapData.has(key)) {
        mapData.delete(key);
        render();
        setLog(
          `Ключ "${key}" удален из Map за фиксированное время.`,
          "O(1)",
          "success",
        );
      } else {
        setLog(`Ключ "${key}" не найден.`, "O(1)", "error");
      }
    }
  });

  // Вспомогательные подсвечивалки
  function highlightSetItem(val: string, className: string) {
    const items = document.querySelectorAll(".set-bubble");
    items.forEach((el) => {
      const htmlEl = el as HTMLElement;
      if (htmlEl.dataset.value === val) {
        htmlEl.classList.add(className);
        setTimeout(() => htmlEl.classList.remove(className), 1500);
      }
    });
  }

  function highlightMapItem(key: string, className: string) {
    const items = document.querySelectorAll(".map-row");
    items.forEach((el) => {
      const htmlEl = el as HTMLElement;
      if (htmlEl.dataset.key === key) {
        htmlEl.classList.add(className);
        setTimeout(() => htmlEl.classList.remove(className), 1500);
      }
    });
  }

  // Переключение структуры
  dsSelect.addEventListener("change", () => {
    currentDS = dsSelect.value as DSType;
    render();
    setLog(
      `Переключено на ${dsSelect.options[dsSelect.selectedIndex].text}`,
      "Info",
    );
  });

  // Инициализация
  render();
</script>

<style>
  /* Использование CSS Nesting и переменных Tailwind */
  .ds-visualizer {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
    padding: 1.5rem;
    background-color: var(--color-white, #ffffff);
    color: var(--color-slate-800, #1e293b);
    border-radius: var(--radius-xl, 12px);
    border: 1px solid var(--color-slate-200, #e2e8f0);
    box-shadow: 0 10px 25px -5px rgba(0, 0, 0, 0.05);
    max-width: 850px;
    margin: 0 auto;
    font-family:
      system-ui,
      -apple-system,
      sans-serif;

    /* Выбор и форма */
    & .header {
      display: flex;
      flex-wrap: wrap;
      gap: 1rem;
      justify-content: space-between;
      align-items: center;

      & .selector-group {
        display: flex;
        align-items: center;
        gap: 0.5rem;

        & label {
          font-weight: 600;
          font-size: 0.9rem;
          color: var(--color-slate-600, #475569);
        }

        & select {
          padding: 0.5rem 0.8rem;
          border-radius: var(--radius-md, 6px);
          background-color: var(--color-slate-50, #f8fafc);
          border: 1px solid var(--color-slate-300, #cbd5e1);
          font-weight: 600;
          color: var(--color-slate-800, #1e293b);
          cursor: pointer;
        }
      }

      & .action-panel {
        display: flex;
        gap: 0.5rem;
        align-items: center;
        flex-wrap: wrap;

        & .input-wrapper {
          &.hidden {
            display: none;
          }

          & input {
            padding: 0.45rem 0.75rem;
            border-radius: var(--radius-md, 6px);
            border: 1px solid var(--color-slate-300, #cbd5e1);
            width: 110px;
            font-size: 0.9rem;

            &:focus {
              outline: none;
              border-color: var(--color-blue-600, #2563eb);
            }
          }
        }

        & .btn-group {
          display: flex;
          gap: 0.4rem;

          & .btn {
            padding: 0.45rem 0.85rem;
            border-radius: var(--radius-md, 6px);
            border: none;
            font-weight: 600;
            font-size: 0.85rem;
            cursor: pointer;
            transition: all 0.15s ease;

            &.btn-primary {
              background-color: var(--color-blue-600, #2563eb);
              color: var(--color-white, #ffffff);
              &:hover {
                background-color: var(--color-blue-700, #1d4ed8);
              }
            }

            &.btn-secondary {
              background-color: var(--color-slate-100, #f1f5f9);
              color: var(--color-slate-700, #334155);
              border: 1px solid var(--color-slate-200, #e2e8f0);
              &:hover {
                background-color: var(--color-slate-200, #e2e8f0);
              }
            }

            &.btn-danger {
              background-color: var(--color-rose-50, #fff1f2);
              color: var(--color-rose-600, #e11d48);
              border: 1px solid var(--color-rose-200, #fecdd3);
              &:hover {
                background-color: var(--color-rose-100, #ffe4e6);
              }
            }
          }
        }
      }
    }

    /* Баннер лога операций */
    & .log-banner {
      display: flex;
      align-items: center;
      gap: 0.75rem;
      padding: 0.75rem 1rem;
      background-color: var(--color-slate-50, #f8fafc);
      border: 1px solid var(--color-slate-200, #e2e8f0);
      border-radius: var(--radius-md, 6px);
      font-size: 0.875rem;

      & .log-title {
        font-weight: 700;
        color: var(--color-slate-500, #64748b);
      }

      & .log-text {
        flex: 1;
        color: var(--color-slate-800, #1e293b);
      }

      & .log-badge {
        padding: 0.2rem 0.6rem;
        border-radius: 999px;
        font-family: ui-monospace, monospace;
        font-weight: 700;
        font-size: 0.8rem;
        background-color: var(--color-blue-100, #dbeafe);
        color: var(--color-blue-700, #1d4ed8);

        &.badge-success {
          background-color: var(--color-emerald-100, #d1fae5);
          color: var(--color-emerald-700, #047857);
        }

        &.badge-warn {
          background-color: var(--color-amber-100, #fef3c7);
          color: var(--color-amber-700, #b45309);
        }

        &.badge-error {
          background-color: var(--color-rose-100, #ffe4e6);
          color: var(--color-rose-700, #be123c);
        }
      }
    }

    /* Холст */
    & .canvas {
      min-height: 180px;
      padding: 1.5rem;
      background-color: var(--color-slate-50, #f8fafc);
      border-radius: var(--radius-lg, 8px);
      border: 1px solid var(--color-slate-200, #e2e8f0);
      display: flex;
      align-items: center;

      &.flex-row {
        display: flex;
        flex-direction: row;
        align-items: center;
        gap: 0.5rem;
        overflow-x: auto;
      }

      &.flex-wrap {
        display: flex;
        flex-wrap: wrap;
        gap: 1rem;
        align-content: flex-start;
      }

      &.flex-col {
        display: flex;
        flex-direction: column;
        gap: 0.5rem;
        width: 100%;
      }

      /* Массив */
      & .array-node {
        display: flex;
        flex-direction: column;
        align-items: center;

        & .node-body {
          width: 50px;
          height: 50px;
          background-color: var(--color-white, #ffffff);
          border: 2px solid var(--color-blue-500, #3b82f6);
          color: var(--color-blue-700, #1d4ed8);
          border-radius: var(--radius-md, 6px);
          display: flex;
          align-items: center;
          justify-content: center;
          font-weight: 700;
          transition: all 0.2s ease;
        }

        & .node-idx {
          font-size: 0.75rem;
          color: var(--color-slate-400, #94a3b8);
          margin-top: 4px;
          font-family: monospace;
        }
      }

      /* Связный список */
      & .ll-node {
        & .ll-content {
          padding: 0.5rem 0.8rem;
          background-color: var(--color-white, #ffffff);
          border: 2px solid var(--color-indigo-500, #6366f1);
          border-radius: var(--radius-md, 6px);
          display: flex;
          gap: 0.5rem;

          & .val {
            font-weight: 700;
            color: var(--color-indigo-900, #312e81);
          }
          & .ptr {
            font-size: 0.75rem;
            color: var(--color-indigo-400, #818cf8);
            border-left: 1px solid #e0e7ff;
            padding-left: 0.4rem;
          }
        }
      }

      & .ll-arrow {
        font-weight: bold;
        color: var(--color-indigo-400, #818cf8);
      }
      & .ll-null {
        font-size: 0.85rem;
        font-weight: 600;
        color: var(--color-slate-400, #94a3b8);
      }

      /* Множество (Set) */
      & .set-bubble {
        padding: 0.6rem 1.2rem;
        background-color: var(--color-emerald-500, #10b981);
        color: var(--color-white, #ffffff);
        font-weight: 700;
        border-radius: 999px;
        box-shadow: 0 2px 4px rgba(16, 185, 129, 0.2);
        transition: all 0.2s ease;
      }

      /* Хэш-карта (Map) */
      & .map-row {
        display: flex;
        gap: 0.75rem;
        padding: 0.6rem 1rem;
        background-color: var(--color-white, #ffffff);
        border: 1px solid var(--color-slate-200, #e2e8f0);
        border-radius: var(--radius-md, 6px);
        width: 100%;
        max-width: 320px;
        font-family: ui-monospace, monospace;

        & .map-key {
          color: var(--color-purple-600, #9333ea);
          font-weight: 700;
        }
        & .map-val {
          color: var(--color-amber-600, #d97706);
        }
      }

      /* Анимации подсветок при поиске */
      & .highlight-search {
        transform: scale(1.1);
        box-shadow: 0 0 0 4px var(--color-amber-400, #fbbf24) !important;
      }

      & .highlight-found {
        transform: scale(1.1);
        box-shadow: 0 0 0 4px var(--color-emerald-500, #10b981) !important;
      }

      & .highlight-warn {
        transform: scale(1.1);
        box-shadow: 0 0 0 4px var(--color-amber-500, #f59e0b) !important;
      }
    }
  }
</style>


