---
export interface Props {
  bgColor?: string;
  textColor?: string;
  text: string;
  size?: string;
  viewBox?: string;
  letters?: number;
  fontSize?: string;
}

const {
  text = "?",
  bgColor = "#54a3e8",
  textColor = "#ffffff",
  size = "100%",
  viewBox = "0 0 50 50",
  letters = 1,
  fontSize = "100%",
} = Astro.props;

const initials = text.slice(0, letters).toUpperCase();
---

<svg
  class="avatar-svg"
  viewBox={viewBox}
  xmlns="http://www.w3.org/2000/svg"
  style={size !== "100%" ? `width: ${size}; height: ${size};` : undefined}
>
  <rect width="100%" height="100%" rx="50%" fill={bgColor}></rect>
  <text
    x="50%"
    y="50%"
    fill={textColor}
    font-size={fontSize}
    font-weight="600"
    font-family="system-ui, -apple-system, sans-serif"
    dominant-baseline="middle"
    text-anchor="middle"
  >
    {initials}
  </text>
</svg>

<style>
  .avatar-svg {
    height: 100%;
    width: auto;
    aspect-ratio: 1 / 1;
    flex-shrink: 0;
    display: block;
  }
</style>
