---
import SvgAvatar from "./SvgAvatar.astro";
import { VolumeOff } from "@lucide/astro";

interface Props {
  name: string;
  message: string;
  time: string;
}

const { name = "?", message = "", time } = Astro.props;
---

<tg-chat-item>
  <SvgAvatar text="ABC" />
  <div class="content-wrapper">
    <div class="top-wrapper">
      <span class="name">{name}</span>
      <VolumeOff width={15} height={15} />
    </div>
    <div class="bot-wrapper">
      <span class="dialog-message">{message}</span>
    </div>
  </div>
  <span class="time">{time}</span>
</tg-chat-item>

<style>
  tg-chat-item {
    display: flex;
    align-items: center;
    position: relative;
    box-sizing: border-box;
    width: 100%;
    height: 72px;
    padding: var(--spacing-2);

    background-color: #212121;
    border-radius: 10px;

    &:hover {
      background-color: rgba(255, 255, 255, 0.05);
      cursor: pointer;
    }

    .time {
      position: absolute;
      color: #aaaaaa;
      top: var(--spacing-2);
      right: var(--spacing-2);
      font-size: 0.8rem;
    }

    .content-wrapper {
      display: flex;
      flex-direction: column;
      width: 100%;
      margin-left: var(--spacing-2);

      .top-wrapper {
        display: flex;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
        align-items: center;
        gap: 8px;

        .name {
          color: white;
          white-space: nowrap;
          overflow: hidden;
          text-overflow: ellipsis;
        }

        .lucide-volume-off {
          display: flex;
          flex-shrink: 0;
          color: #9e9e9e;
        }
      }

      .bot-wrapper {
        .dialog-message {
          color: #aaaaaa;
          display: block;
          white-space: nowrap;
          overflow: hidden;
          text-overflow: ellipsis;
        }
      }
    }
  }
</style>
