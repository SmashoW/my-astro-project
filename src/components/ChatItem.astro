---
import SvgAvatar from "./SvgAvatar.astro";
import { VolumeOff } from "@lucide/astro";

interface Props {
    name: string;
    message: string;
    time: string;
}

const { name = "?", message = "", time } = Astro.props;
---

<tg-chat-item>
    <SvgAvatar text="ABC" />
    <div class="content-wrapper">
        <div class="top-wrapper">
            <span class="name">{name}</span>
            <VolumeOff width={15} height={15} />
        </div>
        <div class="bot-wrapper">
            <span class="dialog-message">{message}</span>
        </div>
    </div>
    <span class="time">{time}</span>
</tg-chat-item>

<style>
    tg-chat-item {
        display: flex;
        align-items: center;
        position: relative;
        box-sizing: border-box;
        width: 100%;
        max-height: 72px;
        padding: 8px;

        background-color: #212121;
        border-radius: 10px;

        &:hover {
            background-color: rgba(255, 255, 255, 0.05);
            cursor: pointer;
        }

        .time {
            position: absolute;
            color: #aaaaaa;
            top: 5px;
            right: 7px;
            font-size: 13px;
        }

        .content-wrapper {
            display: flex;
            flex-direction: column;
            max-width: 320px;

            .top-wrapper {
                display: flex;
                white-space: nowrap;
                overflow: hidden;
                text-overflow: ellipsis;

                .name {
                    color: white;
                    padding-left: 10px;
                    white-space: nowrap;
                    overflow: hidden;
                    text-overflow: ellipsis;
                }

                .lucide-volume-off {
                    display: flex;
                    flex-shrink: 0;
                    color: #9e9e9e;
                    margin-left: 5px;
                    margin-top: 5px;
                }
            }

            .dialog-message {
                color: #aaaaaa;
                padding-left: 10px;
                display: block;
                white-space: nowrap;
                overflow: hidden;
                text-overflow: ellipsis;
            }
        }
    }
</style>
