---
// Серверная часть Astro
---

<div class="sort-visualizer">
  <!-- Верхняя панель управления -->
  <div class="controls">
    <div class="control-group">
      <label for="algo-select">Алгоритм:</label>
      <select id="algo-select">
        <option value="bubble">Сортировка пузырьком (Bubble Sort)</option>
        <option value="selection">Сортировка выбором (Selection Sort)</option>
        <option value="insertion">Сортировка вставками (Insertion Sort)</option>
      </select>
    </div>

    <div class="button-group">
      <button id="btn-run" class="btn btn-primary">Запустить</button>
      <button id="btn-step" class="btn btn-secondary">Пошагово</button>
      <button id="btn-reset" class="btn btn-secondary"
        >К начальной позиции</button
      >
      <button id="btn-generate" class="btn btn-outline">Новый массив</button>
    </div>
  </div>

  <!-- Блок сложности алгоритма (O-нотация) -->
  <div class="complexity-container">
    <div class="complexity-card">
      <span class="label">Худшее время</span>
      <span class="value" id="comp-worst">O(n²)</span>
    </div>
    <div class="complexity-card">
      <span class="label">Среднее время</span>
      <span class="value" id="comp-avg">O(n²)</span>
    </div>
    <div class="complexity-card">
      <span class="label">Лучшее время</span>
      <span class="value" id="comp-best">O(n)</span>
    </div>
    <div class="complexity-card">
      <span class="label">Память</span>
      <span class="value" id="comp-space">O(1)</span>
    </div>
  </div>

  <!-- Визуализация массива -->
  <div id="chart-container" class="chart-container">
    <!-- Столбцы генерируются через JS -->
  </div>
</div>

<script>
  // --- Типы ---
  type StepResult = {
    array: number[];
    comparing?: number[];
    swapped?: boolean;
    finished?: boolean;
  };

  type AlgorithmMeta = {
    fn: (arr: number[]) => Generator<StepResult>;
    complexity: {
      worst: string;
      average: string;
      best: string;
      space: string;
    };
  };

  // --- Алгоритмы-генераторы ---

  function* bubbleSortSteps(arr: number[]): Generator<StepResult> {
    const a = [...arr];
    const n = a.length;
    for (let i = 0; i < n; i++) {
      for (let j = 0; j < n - i - 1; j++) {
        yield { array: [...a], comparing: [j, j + 1] };
        if (a[j] > a[j + 1]) {
          [a[j], a[j + 1]] = [a[j + 1], a[j]];
          yield { array: [...a], comparing: [j, j + 1], swapped: true };
        }
      }
    }
    yield { array: [...a], comparing: [], finished: true };
  }

  function* selectionSortSteps(arr: number[]): Generator<StepResult> {
    const a = [...arr];
    const n = a.length;
    for (let i = 0; i < n - 1; i++) {
      let minIdx = i;
      for (let j = i + 1; j < n; j++) {
        yield { array: [...a], comparing: [minIdx, j] };
        if (a[j] < a[minIdx]) {
          minIdx = j;
        }
      }
      if (minIdx !== i) {
        [a[i], a[minIdx]] = [a[minIdx], a[i]];
        yield { array: [...a], comparing: [i, minIdx], swapped: true };
      }
    }
    yield { array: [...a], comparing: [], finished: true };
  }

  function* insertionSortSteps(arr: number[]): Generator<StepResult> {
    const a = [...arr];
    for (let i = 1; i < a.length; i++) {
      let j = i;
      yield { array: [...a], comparing: [j - 1, j] };
      while (j > 0 && a[j - 1] > a[j]) {
        [a[j - 1], a[j]] = [a[j], a[j - 1]];
        yield { array: [...a], comparing: [j - 1, j], swapped: true };
        j--;
      }
    }
    yield { array: [...a], comparing: [], finished: true };
  }

  // --- Карта алгоритмов с их O-нотацией ---
  const algorithmsMap: Record<string, AlgorithmMeta> = {
    bubble: {
      fn: bubbleSortSteps,
      complexity: {
        worst: "O(n²)",
        average: "O(n²)",
        best: "O(n)",
        space: "O(1)",
      },
    },
    selection: {
      fn: selectionSortSteps,
      complexity: {
        worst: "O(n²)",
        average: "O(n²)",
        best: "O(n²)",
        space: "O(1)",
      },
    },
    insertion: {
      fn: insertionSortSteps,
      complexity: {
        worst: "O(n²)",
        average: "O(n²)",
        best: "O(n)",
        space: "O(1)",
      },
    },
  };

  // --- Состояние ---
  let initialArray: number[] = [45, 20, 75, 90, 15, 60, 30, 80, 50, 10, 95, 35];
  let currentArray: number[] = [...initialArray];
  let generator: Generator<StepResult> | null = null;
  let isRunning = false;
  let timerId: number | null = null;

  // --- Элементы DOM ---
  const algoSelect = document.getElementById(
    "algo-select",
  ) as HTMLSelectElement;
  const btnRun = document.getElementById("btn-run") as HTMLButtonElement;
  const btnStep = document.getElementById("btn-step") as HTMLButtonElement;
  const btnReset = document.getElementById("btn-reset") as HTMLButtonElement;
  const btnGenerate = document.getElementById(
    "btn-generate",
  ) as HTMLButtonElement;
  const chartContainer = document.getElementById(
    "chart-container",
  ) as HTMLDivElement;

  const compWorst = document.getElementById("comp-worst") as HTMLElement;
  const compAvg = document.getElementById("comp-avg") as HTMLElement;
  const compBest = document.getElementById("comp-best") as HTMLElement;
  const compSpace = document.getElementById("comp-space") as HTMLElement;

  // --- Обновление информации о сложности ---
  function updateComplexityDisplay() {
    const selectedKey = algoSelect.value;
    const { complexity } = algorithmsMap[selectedKey];
    compWorst.textContent = complexity.worst;
    compAvg.textContent = complexity.average;
    compBest.textContent = complexity.best;
    compSpace.textContent = complexity.space;
  }

  // --- Отрисовка ---
  function render(
    arr: number[],
    comparing: number[] = [],
    swapped = false,
    isFinished = false,
  ) {
    chartContainer.innerHTML = "";
    const maxVal = Math.max(...arr, 1);

    arr.forEach((value, idx) => {
      const bar = document.createElement("div");
      bar.className = "bar";

      const heightPercent = (value / maxVal) * 100;
      bar.style.height = `${heightPercent}%`;

      const label = document.createElement("span");
      label.textContent = String(value);
      bar.appendChild(label);

      if (isFinished) {
        bar.classList.add("sorted");
      } else if (comparing.includes(idx)) {
        bar.classList.add(swapped ? "swapped" : "comparing");
      }

      chartContainer.appendChild(bar);
    });
  }

  // --- Управление ---
  function step(): boolean {
    if (!generator) {
      const selectedKey = algoSelect.value;
      generator = algorithmsMap[selectedKey].fn(currentArray);
    }

    const res = generator.next();

    if (res.done || res.value.finished) {
      render(currentArray, [], false, true);
      stopAutoRun();
      return true;
    }

    currentArray = res.value.array;
    render(currentArray, res.value.comparing || [], res.value.swapped || false);
    return false;
  }

  function startAutoRun() {
    isRunning = true;
    btnRun.textContent = "Пауза";
    btnStep.disabled = true;
    algoSelect.disabled = true;

    timerId = window.setInterval(() => {
      const finished = step();
      if (finished) stopAutoRun();
    }, 180);
  }

  function stopAutoRun() {
    isRunning = false;
    btnRun.textContent = "Запустить";
    btnStep.disabled = false;
    algoSelect.disabled = false;
    if (timerId !== null) {
      clearInterval(timerId);
      timerId = null;
    }
  }

  function resetToInitial() {
    stopAutoRun();
    currentArray = [...initialArray];
    generator = null;
    render(currentArray);
  }

  function generateNewArray() {
    stopAutoRun();
    initialArray = Array.from(
      { length: 12 },
      () => Math.floor(Math.random() * 90) + 10,
    );
    currentArray = [...initialArray];
    generator = null;
    render(currentArray);
  }

  // --- Слушатели событий ---
  btnRun.addEventListener("click", () =>
    isRunning ? stopAutoRun() : startAutoRun(),
  );
  btnStep.addEventListener("click", () => step());
  btnReset.addEventListener("click", () => resetToInitial());
  btnGenerate.addEventListener("click", () => generateNewArray());
  algoSelect.addEventListener("change", () => {
    resetToInitial();
    updateComplexityDisplay();
  });

  // Инициализация
  updateComplexityDisplay();
  render(currentArray);
</script>

<style>
  /* CSS Nesting + Переменные Tailwind CSS */
  .sort-visualizer {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
    padding: 1.75rem;
    background-color: var(--color-white, #ffffff);
    color: var(--color-slate-800, #1e293b);
    border-radius: var(--radius-xl, 12px);
    font-family:
      system-ui,
      -apple-system,
      sans-serif;
    max-width: 800px;
    margin: 0 auto;
    border: 1px solid var(--color-slate-200, #e2e8f0);
    box-shadow: 0 10px 25px -5px rgba(0, 0, 0, 0.05);

    /* Элементы управления */
    & .controls {
      display: flex;
      flex-wrap: wrap;
      gap: 1rem;
      justify-content: space-between;
      align-items: center;

      & .control-group {
        display: flex;
        align-items: center;
        gap: 0.5rem;

        & label {
          font-weight: 600;
          font-size: 0.9rem;
          color: var(--color-slate-600, #475569);
        }

        & select {
          padding: 0.5rem 0.8rem;
          border-radius: var(--radius-md, 6px);
          background-color: var(--color-slate-50, #f8fafc);
          color: var(--color-slate-900, #0f172a);
          border: 1px solid var(--color-slate-300, #cbd5e1);
          outline: none;
          cursor: pointer;
          font-size: 0.9rem;
          transition:
            border-color 0.2s,
            box-shadow 0.2s;

          &:focus {
            border-color: var(--color-blue-600, #2563eb);
            box-shadow: 0 0 0 3px rgba(37, 99, 235, 0.15);
          }

          &:disabled {
            opacity: 0.6;
            cursor: not-allowed;
            background-color: var(--color-slate-100, #f1f5f9);
          }
        }
      }

      & .button-group {
        display: flex;
        gap: 0.5rem;
        flex-wrap: wrap;

        & .btn {
          padding: 0.5rem 1rem;
          border-radius: var(--radius-md, 6px);
          border: none;
          font-weight: 600;
          font-size: 0.9rem;
          cursor: pointer;
          transition: all 0.2s ease;

          &:disabled {
            opacity: 0.5;
            cursor: not-allowed;
          }

          &.btn-primary {
            background-color: var(--color-blue-600, #2563eb);
            color: var(--color-white, #ffffff);

            &:hover:not(:disabled) {
              background-color: var(--color-blue-700, #1d4ed8);
              box-shadow: 0 2px 4px rgba(37, 99, 235, 0.2);
            }
          }

          &.btn-secondary {
            background-color: var(--color-slate-100, #f1f5f9);
            color: var(--color-slate-700, #334155);
            border: 1px solid var(--color-slate-200, #e2e8f0);

            &:hover:not(:disabled) {
              background-color: var(--color-slate-200, #e2e8f0);
              color: var(--color-slate-900, #0f172a);
            }
          }

          &.btn-outline {
            background-color: transparent;
            border: 1px solid var(--color-slate-300, #cbd5e1);
            color: var(--color-slate-600, #475569);

            &:hover:not(:disabled) {
              background-color: var(--color-slate-50, #f8fafc);
              border-color: var(--color-slate-400, #94a3b8);
              color: var(--color-slate-900, #0f172a);
            }
          }
        }
      }
    }

    /* Блок O-нотации */
    & .complexity-container {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(130px, 1fr));
      gap: 0.75rem;

      & .complexity-card {
        background-color: var(--color-slate-50, #f8fafc);
        border: 1px solid var(--color-slate-200, #e2e8f0);
        border-radius: var(--radius-md, 6px);
        padding: 0.6rem 0.8rem;
        display: flex;
        flex-direction: column;
        align-items: center;

        & .label {
          font-size: 0.75rem;
          color: var(--color-slate-500, #64748b);
          font-weight: 500;
        }

        & .value {
          font-size: 1.1rem;
          font-weight: 700;
          color: var(--color-blue-600, #2563eb);
          font-family:
            ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
          margin-top: 2px;
        }
      }
    }

    /* График */
    & .chart-container {
      display: flex;
      align-items: flex-end;
      justify-content: center;
      gap: 8px;
      height: 260px;
      padding: 1.5rem 1rem 0.5rem 1rem;
      background-color: var(--color-slate-50, #f8fafc);
      border-radius: var(--radius-lg, 8px);
      border: 1px solid var(--color-slate-200, #e2e8f0);

      & .bar {
        flex: 1;
        max-width: 42px;
        background-color: var(--color-blue-500, #3b82f6);
        border-radius: 6px 6px 0 0;
        display: flex;
        align-items: flex-start;
        justify-content: center;
        padding-top: 6px;
        font-size: 0.75rem;
        color: var(--color-white, #ffffff);
        font-weight: bold;
        transition:
          height 0.15s ease,
          background-color 0.15s ease;

        /* Состояния цветов из палитры Tailwind */
        &.comparing {
          background-color: var(--color-amber-500, #f59e0b);
        }

        &.swapped {
          background-color: var(--color-red-500, #ef4444);
        }

        &.sorted {
          background-color: var(--color-emerald-500, #10b981);
        }
      }
    }
  }
</style>



